# Bunch — environment template
#
#   cp .env.example .env.local
#
# SETUP.md walks through two paths. Path A (local walkthrough) needs only the
# first two blocks below. Everything after that is for a real deployment.

# ---------------------------------------------------------------------------
# Database — required. There is no database-free mode.
# ---------------------------------------------------------------------------
# SYSTEM_DEMO_MODE removes the sign-in and cloud-storage requirements, but the
# app still reads and writes Postgres. SETUP.md Path A starts a disposable one.

# Runtime connection used by the app. A pooled URL is fine here.
DATABASE_URL=postgres://bunch@127.0.0.1:5432/bunch_dev

# Direct, unpooled connection. Migrations hold a session advisory lock, which a
# transaction pooler cannot keep, so this must bypass any pooler.
DATABASE_URL_UNPOOLED=postgres://bunch@127.0.0.1:5432/bunch_dev

# ---------------------------------------------------------------------------
# Path A — local walkthrough (no Auth0, no cloud accounts)
# ---------------------------------------------------------------------------

# Accepts a browser session without Auth0, swaps the legacy repository for an
# in-memory one, and writes images to private-uploads/ instead of Vercel Blob.
# NEVER set this to true on a deployed instance.
SYSTEM_DEMO_MODE=true

# The origin this instance serves from. Used to build the ChatGPT widget HTML
# and the private image endpoints. It has no fallback: the MCP server refuses
# to start without it, so a clone can never point at another install.
SYSTEM_PUBLIC_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Path B — real sign-in (Auth0). Omit entirely while SYSTEM_DEMO_MODE=true.
# ---------------------------------------------------------------------------
# Sign-in stays disabled until all four AUTH0_* values are present.

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Session cookie encryption key. Generate with: openssl rand -hex 32
AUTH0_SECRET=

# Public base URL of this instance. Read inside the Auth0 SDK rather than by
# app code, so searching the source for it finds nothing — it is still needed.
APP_BASE_URL=http://localhost:3000

# Identifier of the Auth0 API guarding the MCP endpoint. Must match the
# audience Auth0 issues access tokens for.
MCP_RESOURCE_URL=http://localhost:3000/mcp

# ---------------------------------------------------------------------------
# Storage and signing secrets
# ---------------------------------------------------------------------------

# Vercel Private Blob token. Unused while SYSTEM_DEMO_MODE=true, and supplied
# automatically when running on Vercel.
BLOB_READ_WRITE_TOKEN=

# Independent HMAC keys for the short-lived capability tokens that let the
# ChatGPT widget upload one image, and that authorize a profile erasure.
# Generate each separately with: openssl rand -hex 32
MCP_TOKEN_SIGNING_SECRET=
ERASURE_TOKEN_SIGNING_SECRET=

# Shared secret the scheduled cleanup route checks before expiring records.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Required by `npm run test:ci`, which refuses to run without it rather than
# silently skipping database tests. Use a throwaway database — it gets written.
TEST_DATABASE_URL=postgres://bunch@127.0.0.1:5432/bunch_test

# Database for the Playwright browser suite, which starts its own server.
E2E_DATABASE_URL=postgres://bunch@127.0.0.1:5432/bunch_e2e

# Lets the browser suite authenticate with a synthetic subject header instead
# of a real login. Refused in a production build. Test harness only.
SYSTEM_E2E_TEST_MODE=false

# Browser suite knobs: which server to test, where evidence is written, and
# which port the suite starts its own server on.
MOBILE_TEST_SERVER=local
MOBILE_TEST_OUTPUT=test-results/playwright
PLAYWRIGHT_PORT=3217

# ---------------------------------------------------------------------------
# Operator scripts
# ---------------------------------------------------------------------------

# Encrypted backup destination and its key (openssl rand -hex 32).
PILOT_BACKUP_DIR=
PILOT_BACKUP_KEY=

# Restore target. Point this at the recovery database, never at the live one.
PILOT_RESTORE_DATABASE_URL=

# A live MCP endpoint and an access token issued for it, used by
# `npm run verify:hosted-mcp` to run acceptance against a real deployment.
HOSTED_MCP_URL=
HOSTED_MCP_ACCESS_TOKEN=
