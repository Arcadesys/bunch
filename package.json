{
  "name": "system-arcades-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:mobile": "playwright test --grep-invert @eval",
    "eval:mobile": "playwright test --grep @eval",
    "test:browser": "playwright test",
    "typecheck:browser": "tsc --noEmit --project tests/mobile/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "record:front": "tsx scripts/record-current-front.ts",
    "record:note": "tsx scripts/save-system-note.ts",
    "verify:hosted-mcp": "tsx scripts/verify-hosted-mcp.ts",
    "eval:mcp": "node -e \"if (!process.env.TEST_DATABASE_URL) { console.error('TEST_DATABASE_URL is required for MCP evals'); process.exit(1); }\" && node --import tsx --test src/server/arrival-catch-up.eval.test.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.28.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
